{
  "name": "@investorade/site-cms-core",
  "version": "1.1.0",
  "description": "Shared, versioned CMS core for Investorade sites (Astro + Sveltia).",
  "type": "module",
  "license": "UNLICENSED",
  "repository": "github:Investorade/site-cms-core",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./schemas": { "types": "./dist/schemas.d.ts", "default": "./dist/schemas.js" },
    "./worker": { "types": "./dist/worker.d.ts", "default": "./dist/worker.js" },
    "./lib/*": { "types": "./dist/lib/*.d.ts", "default": "./dist/lib/*.js" },
    "./components/*": "./components/*",
    "./package.json": "./package.json"
  },
  "files": ["dist", "components", "cms", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "astro": ">=7.4.7"
  },
  "dependencies": {
    "marked": "^15.0.12",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "astro": "^7.4.7",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
